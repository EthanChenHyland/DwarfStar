+// A telemetry poll keeps the ring recording for its window and is answered with the source's JSON
+// batch (a StatusJson reuses the status correlation machinery). An unknown level is clamped off.
+bool NativeRuntime::handleTelemetry(const protocol::TelemetryRequestFrame &request) {
+  if (!telemetryProvider_)
+    throw std::runtime_error("no telemetry source");
+  const int level = request.level > static_cast<uint8_t>(TelemetryLevel::Advanced)
+                        ? static_cast<int>(TelemetryLevel::Advanced)
+                        : static_cast<int>(request.level);
+  advancedTelemetry_.refresh(static_cast<TelemetryLevel>(level), config_.monotonicMilliseconds());
+  std::string json = telemetryProvider_(request.sinceSequence, level);
+  if (json.empty())
+    throw std::runtime_error("empty telemetry document");
+  return send(protocol::StatusJsonEvent{request.correlationId, std::move(json)});
+}
