+// DwarfStar advanced telemetry. The ring's records since `sinceSequence`, with a dropped count and
+// the sequence to continue from, plus capability metadata so a consumer renders only what the
+// runtime reports. Fields per decode-cycle record: the batch width, output tokens, drafted and
+// accepted draft tokens, and the step's wall and cycle milliseconds. PLE, KV, prefix cache and
+// memory are not duplicated here: they are already in /status, from which a consumer takes deltas.
+std::string ServingRuntime::telemetryJson(uint64_t sinceSequence, int level) {
+  std::vector<TelemetryRecord> records;
+  const TelemetryRing::Drain drain = nativeLoop_->telemetryRing().drain(sinceSequence, records);
+  json::Writer w;
+  w.object([&] {
+    w.field("schema", 1u);
+    w.field("level", level);
+    w.field("next", drain.next);
+    w.field("dropped", drain.dropped);
+    w.object("capabilities", [&] {
+      // What this runtime can report, and how. A consumer draws only these.
+      w.field("dflash", "cycle");          // per verify-cycle proposals and acceptance (this ring)
+      w.field("routing", "unavailable");   // Splash does not report per-token expert selections
+      w.field("experts", "unavailable");
+      w.field("ple", "aggregate_via_status");
+      w.field("kv", "via_status");
+      w.field("prefix_cache", "via_status");
+      w.field("memory", "via_status");
+    });
+    w.array("events", [&] {
+      for (const TelemetryRecord &record : records) {
+        if (record.kind != TelemetryKind::DecodeCycle)
+          continue;
+        w.object([&] {
+          w.field("seq", record.sequence);
+          w.key("t").exact(record.monotonicMs);
+          w.field("kind", "decode_cycle");
+          w.field("width", record.a);
+          w.field("output", record.b);
+          w.field("drafted", record.c);
+          w.field("accepted", record.d);
+          w.key("wall_ms").exact(record.e);
+          w.key("cycle_ms").exact(record.f);
+        });
+      }
+    });
+  });
+  return w.str();
+}
