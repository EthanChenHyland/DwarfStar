+// A BF16 shared expert whose width (the routed experts' width) is a whole
+// number of 64 values but not of 256, as Cyber's 640-wide one: BF16, whose
+// native block is 256 values, cannot tile its down projection, so the planner
+// repacks it into BF16S planes (64-value blocks) of the same values; its gate
+// and up projections, as wide as the hidden size, stay BF16. Every repack
+// reads the tensor's rows as stored: the prepared values are the GGUF's.
+// Before BF16S the plan refused it ("tensor is not tile aligned").
+void checkBf16SharedExpertWidth(const std::filesystem::path &directory) {
+  SmallTarget target = smallTarget(true);
+  model::QwenTargetDimensions &g = target.geometry;
+  g.expertIntermediateSize = 320;
+  target.tensors = targetTensors(g, {{"attn_qkv.weight", kQ8_0},
+                                     {"attn_gate.weight", kQ8_0},
+                                     {"ssm_out.weight", kQ8_0},
+                                     {"ffn_gate_exps.weight", kQ8_0},
+                                     {"ffn_up_exps.weight", kQ8_0},
+                                     {"ffn_down_exps.weight", kQ8_0},
+                                     {"ffn_gate_shexp.weight", model::ggml::kBF16},
+                                     {"ffn_up_shexp.weight", model::ggml::kBF16},
+                                     {"ffn_down_shexp.weight", model::ggml::kBF16},
+                                     {"output.weight", kQ8_0},
+                                     {"token_embd.weight", kQ8_0}});
+  randomize(target.tensors, 1500);
+  const auto path = directory / "bf16-shared-320.gguf";
+  writeGguf(path, target.tensors, g);
+  // The plan's rows read `source`, which stays open while they are read.
+  const auto source = std::make_unique<model::WeightSource>(path);
+  Plan result;
+  try {
+    const model::GgufFile gguf(*source);
+    result = {model::gguf::planImages(gguf, architecture(g), g), std::nullopt};
+  } catch (const model::GgufError &error) {
+    result = {{}, error.what()};
+  }
+  check(!result.error, "planner plans a BF16 shared expert 320 values wide" +
+                           (result.error ? ": " + *result.error : ""));
+  if (result.error) return;
+  const struct {
+    const char *name;
+    uint32_t format;
+    uint64_t rows, columns;
+  } cases[] = {{"blk.0.ffn_down_shexp.weight", GGUF_FMT_BF16S, g.hiddenSize, g.expertIntermediateSize},
+               {"blk.0.ffn_gate_shexp.weight", GGUF_FMT_BF16, g.expertIntermediateSize, g.hiddenSize},
+               {"blk.0.ffn_up_shexp.weight", GGUF_FMT_BF16, g.expertIntermediateSize, g.hiddenSize}};
+  for (const auto &expected : cases) {
+    const model::gguf::Repack *repack = repackIn(result, expected.name);
+    const test_gguf::Bytes &data = target.data(expected.name);
+    const bool shaped = repack && repack->format == expected.format && repack->rows == expected.rows &&
+                        repack->columns == expected.columns && !repack->sources.empty() &&
+                        repack->sources[0].type == model::ggml::kBF16 &&
+                        repack->sources[0].rowBytes == expected.columns * 2;
+    std::vector<uint8_t> rowsRead(data.size());
+    if (shaped) model::readRepackRows(*repack, 0, expected.rows, rowsRead.data());
+    check(shaped && rowsRead == data, std::string("planner repacks BF16 ") + expected.name + " into " +
+                                          kQuantFormats[expected.format].name + " planes of its rows as stored");
+  }
+}
