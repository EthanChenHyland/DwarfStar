+// ds3 advanced telemetry reader. Everything here runs on a telemetry poll, never on the decode
+// path: it copies the router page (Shared memory, no GPU command), takes differences against the
+// last poll, and takes deltas of the row stores' own counters. Emission is rate-limited so a fast
+// poller gets a few aggregates a second however often it asks.
+namespace {
+
+struct AdvancedPayload final {
+  TelemetryKind kind = TelemetryKind::RouterAggregate;
+  uint32_t phase = 0, steps = 0, step = 0, every = 0, topK = 0;
+  uint64_t routes = 0;
+  double intervalMs = 0;
+  std::vector<std::vector<uint32_t>> layers;
+  // PleAggregate: the table's deltas and levels, then the expert store's.
+  bool table = false, experts = false;
+  uint64_t stages = 0, requestedRows = 0, uniqueRows = 0, hitRows = 0, readRows = 0, readBytes = 0, evictions = 0,
+           prefetchReadRows = 0, cachedRows = 0, cacheCapacityRows = 0, cacheBytes = 0, tableBytes = 0;
+  double readP50Ms = 0, readP95Ms = 0;
+  uint64_t expertLoads = 0, expertRouted = 0, expertRead = 0, expertPrefetched = 0, expertReadBytes = 0,
+           expertResident = 0, expertSlots = 0, expertCount = 0;
+};
+
+struct AdvancedReader final {
+  std::mutex mutex;
+  std::vector<uint32_t> page, previous;
+  double routerEmitMs[2] = {0, 0};
+  uint32_t routerSteps[2] = {0, 0};
+  uint32_t lastSampleStep = 0, pendingSampleStep = 0;
+  uint64_t samplesDropped = 0, samplesReported = 0;
+  uint32_t samplesBase = 0;
+  bool samplesBaseSet = false;
+  bool pleSeen = false;
+  double pleEmitMs = 0;
+  model::SparseRowStats lastTable;
+  model::ExpertStoreStats lastExperts;
+  // An event's detail (per-layer cells, sample ids, row-store fields) by ring sequence, kept for every
+  // consumer: a poll produces an interval once, and each consumer reading "since N" gets the same
+  // events with their detail while it is held. Bounded by bytes and count; the oldest goes first, and a
+  // consumer that falls further behind gets that event's totals (payload: false).
+  std::deque<std::pair<uint64_t, std::shared_ptr<const AdvancedPayload>>> held;
+  size_t heldBytes = 0;
+};
+
+constexpr size_t kHeldPayloadBytes = 4u << 20;
+constexpr size_t kHeldPayloads = 512;
+
+size_t payloadBytes(const AdvancedPayload &payload) {
+  size_t bytes = sizeof(AdvancedPayload);
+  for (const auto &layer : payload.layers)
+    bytes += sizeof(layer) + layer.size() * sizeof(uint32_t);
+  return bytes;
+}
+
+AdvancedReader &advancedReader() {
+  static AdvancedReader *reader = new AdvancedReader;
+  return *reader;
+}
+
+constexpr double kRouterMinIntervalMs[2] = {180.0, 900.0}; // decode, prefill
+constexpr double kPleMinIntervalMs = 450.0;
+
+void readRouter(AdvancedReader &reader, int level, double nowMs, std::vector<AdvancedPayload> &out) {
+  const ops::MoeTelemetryPage &page = ops::MoeTelemetryPage::instance();
+  if (level < static_cast<int>(TelemetryLevel::Advanced) ||
+      !page.snapshot(reader.page, level >= static_cast<int>(TelemetryLevel::Sampled)))
+    return;
+  const std::vector<uint32_t> &now = reader.page;
+  const uint32_t layers = std::min(now[MOE_TM_LAYERS_WORD], uint32_t{MOE_TM_MAX_LAYERS});
+  const uint32_t experts = std::min(now[MOE_TM_EXPERTS_WORD], uint32_t{MOE_TM_SLOTS});
+  const uint32_t topK = std::min(now[MOE_TM_TOPK_WORD], uint32_t{MOE_TM_TOPK});
+  if (reader.previous.size() != MOE_TM_HIST_WORDS)
+    reader.previous.assign(MOE_TM_HIST_WORDS, 0);
+  for (uint32_t phase = 0; phase < 2; ++phase) {
+    if (nowMs - reader.routerEmitMs[phase] < kRouterMinIntervalMs[phase])
+      continue;
+    AdvancedPayload event;
+    event.kind = TelemetryKind::RouterAggregate;
+    event.phase = phase;
+    event.layers.resize(layers);
+    for (uint32_t layer = 0; layer < layers; ++layer) {
+      const uint32_t base = (phase * MOE_TM_MAX_LAYERS + layer) * MOE_TM_SLOTS;
+      for (uint32_t expert = 0; expert < experts; ++expert) {
+        const uint32_t delta = now[MOE_TM_HIST + base + expert] - reader.previous[base + expert]; // wraps
+        if (!delta)
+          continue;
+        event.layers[layer].push_back(expert);
+        event.layers[layer].push_back(delta);
+        event.routes += delta;
+      }
+    }
+    if (!event.routes)
+      continue;
+    const uint32_t plane = phase * MOE_TM_MAX_LAYERS * MOE_TM_SLOTS;
+    std::copy_n(now.begin() + MOE_TM_HIST + plane, MOE_TM_MAX_LAYERS * MOE_TM_SLOTS, reader.previous.begin() + plane);
+    event.steps = now[MOE_TM_STEPS + phase] - reader.routerSteps[phase];
+    reader.routerSteps[phase] = now[MOE_TM_STEPS + phase];
+    event.intervalMs = reader.routerEmitMs[phase] > 0 ? nowMs - reader.routerEmitMs[phase] : 0;
+    reader.routerEmitMs[phase] = nowMs;
+    out.push_back(std::move(event));
+  }
+  if (level < static_cast<int>(TelemetryLevel::Sampled) || !layers || !topK)
+    return;
+  // Sampled decode steps: a slot is whole once every layer wrote it, and safe to report once a
+  // later step began or the slot stood unchanged for a poll. Each slot records its own period.
+  const uint32_t stepsNow = now[MOE_TM_STEPS];
+  std::vector<std::pair<uint32_t, uint32_t>> ready; // step, slot
+  uint32_t pending = 0, inFlight = 0;
+  for (uint32_t slot = 0; slot < MOE_TM_SAMPLE_SLOTS; ++slot) {
+    const uint32_t base = MOE_TM_SAMPLES + slot * MOE_TM_SAMPLE_WORDS;
+    const uint32_t step = now[base];
+    if (step <= reader.lastSampleStep)
+      continue;
+    if (now[base + 1] == layers && (step < stepsNow || step == reader.pendingSampleStep)) {
+      ready.emplace_back(step, slot);
+    } else {
+      ++inFlight; // begun, not yet whole: a later poll reports it
+      if (now[base + 1] == layers)
+        pending = step;
+    }
+  }
+  reader.pendingSampleStep = pending;
+  std::sort(ready.begin(), ready.end());
+  // Drops are counted, not inferred from step gaps (a period change or an idle stretch leaves gaps
+  // nothing was ever written into): the kernel counts the slots it began, and a slot it began since
+  // this reader's first look that was neither reported nor is still in flight was overwritten before
+  // a poll saw it. The count only grows; a slot caught mid-write never inflates it.
+  const uint32_t written = now[MOE_TM_SAMPLES_WRITTEN];
+  if (!reader.samplesBaseSet) {
+    reader.samplesBase = written - inFlight - static_cast<uint32_t>(ready.size()); // wraps
+    reader.samplesBaseSet = true;
+  }
+  reader.samplesReported += ready.size();
+  const uint64_t began = static_cast<uint32_t>(written - reader.samplesBase);
+  if (began > reader.samplesReported + inFlight)
+    reader.samplesDropped = std::max(reader.samplesDropped, began - reader.samplesReported - inFlight);
+  for (const auto &[step, slot] : ready) {
+    reader.lastSampleStep = step;
+    AdvancedPayload event;
+    event.kind = TelemetryKind::RouterSample;
+    event.step = step;
+    event.every = std::max(now[MOE_TM_SAMPLES + slot * MOE_TM_SAMPLE_WORDS + 2], uint32_t{1}); // as taken
+    event.topK = topK;
+    event.layers.resize(layers);
+    const uint32_t base = MOE_TM_SAMPLES + slot * MOE_TM_SAMPLE_WORDS + MOE_TM_SAMPLE_HEADER;
+    for (uint32_t layer = 0; layer < layers; ++layer)
+      event.layers[layer].assign(now.begin() + base + layer * MOE_TM_TOPK,
+                                 now.begin() + base + layer * MOE_TM_TOPK + topK);
+    out.push_back(std::move(event));
+  }
+}
+
+void readStores(AdvancedReader &reader, int level, double nowMs, const std::optional<model::SparseRowStats> &table,
+                const std::optional<model::ExpertStoreStats> &experts, std::vector<AdvancedPayload> &out) {
+  if (level < static_cast<int>(TelemetryLevel::Advanced) || (!table && !experts))
+    return;
+  if (reader.pleSeen && nowMs - reader.pleEmitMs < kPleMinIntervalMs)
+    return;
+  AdvancedPayload event;
+  event.kind = TelemetryKind::PleAggregate;
+  if (table) {
+    event.table = true;
+    for (uint32_t use = 0; use < model::kSparseRowUses; ++use) {
+      const auto &current = table->uses[use];
+      const auto &before = reader.lastTable.uses[use];
+      event.stages += current.stages - before.stages;
+      event.requestedRows += current.requestedRows - before.requestedRows;
+      event.uniqueRows += current.uniqueRows - before.uniqueRows;
+      event.hitRows += current.hitRows - before.hitRows;
+      event.readRows += current.readRows - before.readRows;
+    }
+    event.readBytes = table->readBytes - reader.lastTable.readBytes;
+    event.evictions = table->evictions - reader.lastTable.evictions;
+    event.prefetchReadRows = table->prefetchReadRows - reader.lastTable.prefetchReadRows;
+    event.cachedRows = table->cachedRows;
+    event.cacheCapacityRows = table->cacheCapacityRows;
+    event.cacheBytes = table->cacheBytes;
+    event.tableBytes = table->tableBytes;
+    event.readP50Ms = table->read.p50Milliseconds;
+    event.readP95Ms = table->read.p95Milliseconds;
+  }
+  if (experts) {
+    event.experts = true;
+    for (uint32_t use = 0; use < 2; ++use) {
+      const auto &current = experts->uses[use];
+      const auto &before = reader.lastExperts.uses[use];
+      event.expertLoads += current.loads - before.loads;
+      event.expertRouted += current.routed - before.routed;
+      event.expertRead += current.read - before.read;
+      event.expertPrefetched += current.prefetched - before.prefetched;
+      event.expertReadBytes += current.readBytes - before.readBytes;
+    }
+    event.expertResident = experts->resident;
+    event.expertSlots = experts->slots;
+    event.expertCount = experts->experts;
+  }
+  const bool first = !reader.pleSeen;
+  const bool moved = event.stages || event.readRows || event.hitRows || event.expertLoads || event.expertRead;
+  event.intervalMs = first ? 0 : nowMs - reader.pleEmitMs;
+  if (table)
+    reader.lastTable = *table;
+  if (experts)
+    reader.lastExperts = *experts;
+  reader.pleSeen = true;
+  reader.pleEmitMs = nowMs;
+  if (first || moved)
+    out.push_back(std::move(event));
+}
+
+uint32_t saturate(uint64_t value) {
+  return value > std::numeric_limits<uint32_t>::max() ? std::numeric_limits<uint32_t>::max() : static_cast<uint32_t>(value);
+}
+
