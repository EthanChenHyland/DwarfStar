+#define MOE_TM_SAMPLES (MOE_TM_HIST + MOE_TM_HIST_WORDS)
+// A sample slot: [step, layers written, the period it was taken at, then MOE_TM_TOPK ids per layer].
+#define MOE_TM_SAMPLE_HEADER 3u
+#define MOE_TM_SAMPLE_WORDS (MOE_TM_SAMPLE_HEADER + MOE_TM_MAX_LAYERS * MOE_TM_TOPK)
+#define MOE_TM_WORDS (MOE_TM_SAMPLES + MOE_TM_SAMPLE_SLOTS * MOE_TM_SAMPLE_WORDS)
 
