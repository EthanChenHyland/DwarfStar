--- a/install/gguf.py
+++ b/install/gguf.py
@@ -161,6 +161,13 @@ QWEN35_PATTERN = (
     r"(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+|\p{N}"
     r"| ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+"
 )
+# The qwen2 profile, as Qwen2-family tokenizer.json files (Swift 1.5's among
+# them) split text: Qwen2's letter class without combining marks, after the
+# same NFC normalizer and before the same byte-level BPE.
+QWEN2_PATTERN = (
+    r"(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}"
+    r"| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+"
+)
 # The flint profile, as Flint's own tokenizer.json splits text before its
 # byte-level BPE, without a normalizer: digits in runs of up to three, runs
 # of Han, hiragana and katakana, then o200k's pattern.
@@ -177,6 +184,7 @@ FLINT_PATTERNS = (
 # for: the patterns that split text, each isolating its matches, in order,
 # and whether text is NFC-normalized before them.
 TOKENIZER_PROFILES = {
+    "qwen2": ((QWEN2_PATTERN,), True),
     "qwen35": ((QWEN35_PATTERN,), True),
