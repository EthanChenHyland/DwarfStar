+    def test_qwen2_profile_keeps_qwen2_letters_and_nfc(self):
+        # Qwen2-family GGUFs (Swift 1.5's) declare tokenizer.ggml.pre qwen2:
+        # NFC, then Qwen2's letter class without combining marks.
+        files = gguf.tokenizer_files(
+            self.metadata(fixture() | {"tokenizer.ggml.pre": "qwen2"})
+        )
+        backend = Tokenizer.from_str(files["tokenizer/tokenizer.json"].decode())
+        self.assertEqual(backend.encode("e\u0301").ids, backend.encode("é").ids)
+        for word in ("क्", "a\u035c"):
+            self.assertEqual(len(backend.pre_tokenizer.pre_tokenize_str(word)), 2)
+        self.assertEqual(
+            backend.encode("ab<think><|im_end|>", add_special_tokens=False).ids,
+            [256, 259, 258],
+        )
+        self.assertEqual(
+            [piece for piece, _ in backend.pre_tokenizer.pre_tokenize_str("it's 42")],
+            ["it", "'s", "Ġ", "4", "2"],
+        )
+
